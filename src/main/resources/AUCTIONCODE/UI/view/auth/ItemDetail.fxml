<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="560.0" spacing="0.0" styleClass="app-shell" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.ItemDetailController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="12.0" styleClass="topbar">
         <padding>
            <Insets left="22.0" right="22.0" />
         </padding>
         <children>
            <VBox spacing="3.0">
               <children>
                  <Label styleClass="section-title" text="Thông tin chi tiết" />
                  <Label styleClass="muted" text="Thông tin vật phẩm đấu giá" />
               </children>
            </VBox>
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="18.0">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>
                  <StackPane prefHeight="245.0" styleClass="image-placeholder">
                     <children>
                        <ImageView fx:id="detailImageView" fitHeight="225.0" fitWidth="455.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="muted" text="Hình ảnh sản phẩm" />
                     </children>
                  </StackPane>

                  <VBox spacing="5.0">
                     <children>
                        <Label fx:id="lblDetailName" style="-fx-font-size: 22px; -fx-font-weight: 800;" text="Tên sản phẩm" wrapText="true" />
                        <Label styleClass="muted" text="Mã sản phẩm: --" />
                     </children>
                  </VBox>

                  <Separator />

                  <VBox spacing="8.0">
                     <children>
                        <Label text="Mô tả sản phẩm" style="-fx-font-weight: 800;" />
                        <TextArea editable="false" prefHeight="170.0" wrapText="true" />
                     </children>
                  </VBox>

                  <Separator />

                  <HBox spacing="28.0">
                     <children>
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="muted" text="Người đăng" />
                              <Label style="-fx-font-weight: 800;" text="Nguyễn Văn A" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="muted" text="Tình trạng" />
                              <Label style="-fx-font-weight: 800;" text="Like New" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <HBox alignment="CENTER_RIGHT" prefHeight="72.0" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #e5ebf2; -fx-border-width: 1 0 0 0;">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="BackButton" mnemonicParsing="false" onAction="#BackToMain" prefHeight="40.0" prefWidth="120.0" styleClass="primary-button" text="Đóng" />
         </children>
      </HBox>
   </children>
</VBox>

