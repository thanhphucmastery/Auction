<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="860.0" styleClass="app-shell" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.AddItemController">
   <children>
      <VBox maxWidth="720.0" spacing="18.0" styleClass="surface-card">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Đăng ký món hàng mới" />
                  <Label styleClass="muted" text="Thêm vật phẩm vào kho trước khi mở phiên đấu giá" />
               </children>
            </VBox>

            <GridPane hgap="18.0" vgap="15.0">
               <children>
                  <VBox spacing="7.0" GridPane.columnSpan="2">
                     <children>
                        <Label text="Tên sản phẩm" style="-fx-font-weight: 800;" />
                        <TextField fx:id="itemNameField" prefHeight="44.0" promptText="Nhập tên sản phẩm" />
                     </children>
                  </VBox>

                  <VBox spacing="7.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                     <children>
                        <Label text="Loại sản phẩm" style="-fx-font-weight: 800;" />
                        <ComboBox fx:id="categoryCombo" maxWidth="Infinity" prefHeight="44.0" promptText="Chọn danh mục" />
                     </children>
                  </VBox>

                  <VBox spacing="7.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Mô tả chi tiết" style="-fx-font-weight: 800;" />
                        <TextArea fx:id="descriptionArea" prefHeight="130.0" promptText="Tình trạng, xuất xứ, thông tin bảo hành..." wrapText="true" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label text="Ảnh vật phẩm" style="-fx-font-weight: 800;" />
                        <StackPane prefHeight="130.0" styleClass="image-placeholder">
                           <children>
                              <ImageView fx:id="previewImage" fitHeight="130.0" fitWidth="310.0" preserveRatio="true" />
                              <Label fx:id="imageHintLabel" styleClass="muted" text="Chưa chọn ảnh" />
                           </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#chooseImage" prefHeight="36.0" styleClass="ghost-button" text="▧ Chọn ảnh" />
                     </children>
                  </VBox>

                  <VBox spacing="7.0" GridPane.rowIndex="3">
                     <children>
                        <Label fx:id="extraLabel1" text="Tác giả / người tạo" style="-fx-font-weight: 800;" />
                        <TextField fx:id="extraField1" prefHeight="42.0" />
                     </children>
                  </VBox>
                  <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Label fx:id="extraLabel2" text="Năm sáng tác" style="-fx-font-weight: 800;" />
                        <TextField fx:id="extraField2" prefHeight="42.0" />
                     </children>
                  </VBox>
                  <VBox spacing="7.0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                     <children>
                        <Label fx:id="extraLabel3" text="Không dùng" style="-fx-font-weight: 800;" />
                        <TextField fx:id="extraField3" prefHeight="42.0" disable="true" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="DeclineButton" mnemonicParsing="false" onAction="#DeclineAddItem" prefHeight="42.0" prefWidth="120.0" styleClass="ghost-button" text="× Hủy bỏ" />
                  <Button mnemonicParsing="false" onAction="#handleSaveItem" prefHeight="42.0" prefWidth="170.0" styleClass="primary-button" text="✓ Đăng ký vào kho" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</StackPane>

