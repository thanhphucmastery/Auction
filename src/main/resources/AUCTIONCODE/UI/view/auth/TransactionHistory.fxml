<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="760.0" prefWidth="1120.0" spacing="20.0" styleClass="app-shell" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.TransactionHistoryController">
   <padding>
      <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="surface-card">
         <children>
            <Button mnemonicParsing="false" onAction="#backToMain" prefHeight="38.0" prefWidth="112.0" styleClass="ghost-button" text="Quay lại" />
            <VBox spacing="3.0">
               <children>
                  <Label styleClass="muted" text="TÀI KHOẢN" />
                  <Label styleClass="page-title" text="Lịch sử giao dịch" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="summaryLabel" styleClass="section-title" text="0 giao dịch" />
            <Button mnemonicParsing="false" onAction="#refresh" prefHeight="38.0" prefWidth="112.0" styleClass="primary-button" text="Làm mới" />
         </children>
      </HBox>

      <VBox spacing="12.0" styleClass="surface-card" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="section-title" text="Các phiên đã chốt" />
            <TableView fx:id="transactionTable" styleClass="auction-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colTime" prefWidth="150.0" text="Thời gian" />
                  <TableColumn fx:id="colType" prefWidth="160.0" text="Loại" />
                  <TableColumn fx:id="colItem" prefWidth="240.0" text="Vật phẩm" />
                  <TableColumn fx:id="colAmount" prefWidth="150.0" text="Số tiền" />
                  <TableColumn fx:id="colCounterparty" prefWidth="180.0" text="Đối tác" />
                  <TableColumn fx:id="colNote" prefWidth="260.0" text="Ghi chú" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
