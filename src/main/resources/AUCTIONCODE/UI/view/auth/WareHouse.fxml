<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680.0" prefWidth="980.0" spacing="20.0" styleClass="app-shell" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.WareHouseController">
   <padding>
      <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <children>
            <VBox spacing="3.0">
               <children>
                  <Label styleClass="page-title" text="Kho hàng của tôi" />
                  <Label styleClass="muted" text="Quản lý vật phẩm trước khi đưa lên sàn đấu giá" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefHeight="40.0" prefWidth="260.0" promptText="Tìm kiếm sản phẩm..." />
            <Button fx:id="BackToMainButton" mnemonicParsing="false" onAction="#BackToMain" prefHeight="40.0" prefWidth="110.0" styleClass="ghost-button" text="← Trở về" />
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="itemFlow" hgap="16.0" vgap="16.0">
               <padding>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </padding>
            </FlowPane>
         </content>
      </ScrollPane>
   </children>
</VBox>

