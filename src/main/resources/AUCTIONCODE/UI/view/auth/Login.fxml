<StackPane fx:id="myPaneField" prefHeight="720.0" prefWidth="860.0" style="-fx-background-color: white;" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.LoginController">
   <children>
      <VBox alignment="TOP_CENTER" maxWidth="620.0" spacing="18.0">
         <padding>
            <Insets bottom="22.0" left="42.0" right="42.0" top="34.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Đăng nhập" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #172033;" />
                  <Label text="Chào mừng bạn trở lại" style="-fx-font-size: 15px; -fx-text-fill: #7a8799;" />
               </children>
            </VBox>

            <VBox alignment="CENTER" maxWidth="430.0" spacing="14.0">
               <children>
                  <TextField fx:id="usernameField" prefHeight="54.0" promptText="Tên đăng nhập" style="-fx-font-size: 15px; -fx-padding: 0 18 0 18; -fx-background-color: white; -fx-border-color: #dce3eb; -fx-border-radius: 10; -fx-background-radius: 10;" />
                  <PasswordField fx:id="passwordField" prefHeight="54.0" promptText="Mật khẩu" style="-fx-font-size: 15px; -fx-padding: 0 18 0 18; -fx-background-color: white; -fx-border-color: #dce3eb; -fx-border-radius: 10; -fx-background-radius: 10;" />
                  <Button fx:id="LoginButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="54.0" style="-fx-background-color: linear-gradient(to right, #28c38f, #18b981); -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 800; -fx-cursor: hand;" text="Đăng nhập" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Hyperlink onAction="#handleForgotPassword" text="Quên mật khẩu?" style="-fx-text-fill: #2f5789; -fx-font-weight: 700;" />
                        <Label text="|" style="-fx-text-fill: #c5ccd6;" />
                        <Hyperlink fx:id="registerLink" onAction="#goToRegister" text="Tạo tài khoản" style="-fx-text-fill: #2f5789; -fx-font-weight: 700;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <Pane prefHeight="300.0" prefWidth="620.0">
               <children>
                  <Rectangle arcHeight="42.0" arcWidth="42.0" fill="#f7fbff" height="250.0" layoutX="30.0" layoutY="25.0" stroke="#edf2f7" width="560.0" />

                  <Ellipse fill="#58c98b" layoutX="95.0" layoutY="244.0" radiusX="70.0" radiusY="18.0" />
                  <Ellipse fill="#58c98b" layoutX="520.0" layoutY="244.0" radiusX="70.0" radiusY="18.0" />
                  <Rectangle arcHeight="20.0" arcWidth="20.0" fill="#4baa6f" height="34.0" layoutX="0.0" layoutY="246.0" width="620.0" />

                  <Rectangle arcHeight="8.0" arcWidth="8.0" fill="#8a6d58" height="66.0" layoutX="254.0" layoutY="168.0" width="120.0" />
                  <Rectangle arcHeight="8.0" arcWidth="8.0" fill="#765944" height="16.0" layoutX="239.0" layoutY="160.0" width="150.0" />
