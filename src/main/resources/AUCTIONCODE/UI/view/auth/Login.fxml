                  <Rectangle arcHeight="12.0" arcWidth="12.0" fill="#315c83" height="62.0" layoutX="286.0" layoutY="134.0" width="58.0" />
                  <Line endX="34.0" endY="-18.0" layoutX="344.0" layoutY="150.0" stroke="#315c83" strokeLineCap="ROUND" strokeWidth="9.0" />
                  <Line endX="-30.0" endY="-18.0" layoutX="286.0" layoutY="150.0" stroke="#315c83" strokeLineCap="ROUND" strokeWidth="9.0" />
                  <Rectangle arcHeight="4.0" arcWidth="4.0" fill="#7a4f36" height="8.0" layoutX="367.0" layoutY="123.0" rotate="-25.0" width="30.0" />
                  <Line endX="35.0" endY="16.0" layoutX="383.0" layoutY="130.0" stroke="#7a4f36" strokeLineCap="ROUND" strokeWidth="5.0" />

                  <Circle fill="#f1c7a5" layoutX="150.0" layoutY="182.0" radius="22.0" />
                  <Rectangle arcHeight="20.0" arcWidth="20.0" fill="#2e628b" height="74.0" layoutX="122.0" layoutY="205.0" width="58.0" />
                  <Line endX="18.0" endY="-76.0" layoutX="154.0" layoutY="213.0" stroke="#2e628b" strokeLineCap="ROUND" strokeWidth="12.0" />
                  <Rectangle arcHeight="8.0" arcWidth="8.0" fill="#5ba7d5" height="42.0" layoutX="155.0" layoutY="101.0" width="55.0" />
                  <Label layoutX="166.0" layoutY="111.0" text="BID" style="-fx-font-size: 17px; -fx-font-weight: 900; -fx-text-fill: white;" />

                  <Circle fill="#f1c7a5" layoutX="462.0" layoutY="183.0" radius="22.0" />
                  <Rectangle arcHeight="20.0" arcWidth="20.0" fill="#2e628b" height="74.0" layoutX="434.0" layoutY="205.0" width="58.0" />
                  <Line endX="-18.0" endY="-44.0" layoutX="444.0" layoutY="215.0" stroke="#2e628b" strokeLineCap="ROUND" strokeWidth="12.0" />

                  <Rectangle arcHeight="18.0" arcWidth="18.0" fill="#9ee5bf" height="80.0" layoutX="34.0" layoutY="174.0" rotate="-18.0" width="25.0" />
                  <Rectangle arcHeight="18.0" arcWidth="18.0" fill="#9ee5bf" height="78.0" layoutX="542.0" layoutY="176.0" rotate="18.0" width="25.0" />
               </children>
            </Pane>
         </children>
      </VBox>
   </children>
</StackPane>
