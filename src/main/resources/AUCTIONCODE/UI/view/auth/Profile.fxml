<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="980.0" styleClass="app-shell" stylesheets="@auction-theme.css" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AUCTIONCODE.UI.Controller.auth.ProfileController">
   <children>
      <VBox maxWidth="720.0" spacing="20.0" styleClass="surface-card">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Hồ sơ người dùng" />
                  <Label styleClass="muted" text="Cập nhật thông tin cá nhân dùng trong hệ thống đấu giá" />
               </children>
            </VBox>

            <HBox spacing="18.0">
               <children>
                  <VBox prefWidth="220.0" spacing="8.0" styleClass="stat-card">
                     <children>
                        <Label styleClass="muted" text="Tên đăng nhập" />
                        <Label fx:id="usernameLabel" style="-fx-font-size: 22px; -fx-font-weight: 800;" text="--" />
                        <Label styleClass="muted" text="Vai trò" />
                        <Label fx:id="roleLabel" style="-fx-font-weight: 800;" text="--" />
                     </children>
                  </VBox>

                  <GridPane hgap="16.0" vgap="14.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="7.0" GridPane.columnSpan="2">
                           <children>
                              <Label text="Họ và tên" style="-fx-font-weight: 800;" />
                              <TextField fx:id="fullNameField" prefHeight="42.0" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0" GridPane.rowIndex="1">
                           <children>
                              <Label text="Số điện thoại" style="-fx-font-weight: 800;" />
                              <TextField fx:id="phoneField" prefHeight="42.0" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label text="Email" style="-fx-font-weight: 800;" />
                              <TextField fx:id="emailField" prefHeight="42.0" />
                           </children>
                        </VBox>
                        <VBox spacing="7.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                           <children>
                              <Label text="Địa chỉ" style="-fx-font-weight: 800;" />
                              <TextField fx:id="addressField" prefHeight="42.0" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>
               </children>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button onAction="#BackToMain" prefHeight="42.0" prefWidth="120.0" styleClass="ghost-button" text="Trở về" />
                  <Button onAction="#SaveProfile" prefHeight="42.0" prefWidth="150.0" styleClass="primary-button" text="Lưu thay đổi" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
   </padding>
</StackPane>

